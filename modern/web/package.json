{
  "name": "space-vikings-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "deploy": "npm run build && npx --yes gh-pages -d dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit",
    "extract:applewin": "node tools/extract_applewin_state.mjs",
    "extract:ship-bytecode": "node tools/extract_ship_bytecode_assets.mjs",
    "e2e:modern": "node tools/run_end_to_end.mjs",
    "e2e:modern:log": "node tools/run_end_to_end.mjs 300000",
    "e2e:modern:boot": "node tools/run_end_to_end_with_server.mjs",
    "visual:e2e": "node tools/run_visual_e2e.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "gh-pages": "^6.3.0",
    "playwright": "^1.59.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "three": "^0.184.0"
  }
}
